# AES Decryption Secret Key (Fernet key)
AES_SECRET_KEY=your_fernet_secret_key_here

# MongoDB Connection String (synced with Android Cookie Keeper)
MONGO_DB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0

# Deal Channel to Monitor
TELEGRAM_CHANNEL=https://telegram.me/s/dealsandshit

# Minimum Discount Percentage to Trigger Checkout
MIN_DISCOUNT_PCT=85

# Telegram MTProto API Credentials (for private channels)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_STRING=your_telethon_session_string

# Headless mode for browser execution
HEADLESS=true
